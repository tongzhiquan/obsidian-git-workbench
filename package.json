{
  "name": "obsidian-git-workbench",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Git Workbench: Obsidian 桌面 Git 工作台",
  "author": "tongzhiquan (https://github.com/tongzhiquan)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tongzhiquan/obsidian-git-workbench.git"
  },
  "homepage": "https://github.com/tongzhiquan/obsidian-git-workbench#readme",
  "bugs": {
    "url": "https://github.com/tongzhiquan/obsidian-git-workbench/issues"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs --watch",
    "build": "tsc --noEmit && node esbuild.config.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:obsidian": "npm run build && electron tests/obsidian.cjs",
    "package": "npm run build && node scripts/package.mjs",
    "install-local": "node scripts/install.mjs",
    "reload-local": "node scripts/reload-local.mjs",
    "check-vault": "tsx scripts/check-vault.ts"
  },
  "dependencies": {
    "@codemirror/merge": "6.12.2",
    "diff": "8.0.2"
  },
  "devDependencies": {
    "@codemirror/commands": "6.10.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@electron/remote": "^2.1.3",
    "@types/node": "^24.0.0",
    "electron": "^37.10.3",
    "esbuild": "^0.25.0",
    "fflate": "^0.8.2",
    "obsidian": "1.14.4",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
